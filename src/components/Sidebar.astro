---
import fs from 'node:fs';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL;
// 放一张自己的照片到 public/avatar.(jpg|jpeg|png|webp) 即自动替换占位头像
const avatarExt = ['jpg', 'jpeg', 'png', 'webp'].find((ext) =>
  fs.existsSync(`public/avatar.${ext}`)
);
const avatar = avatarExt ? `${base}avatar.${avatarExt}` : `${base}avatar-placeholder.svg`;
---

<aside class="sidebar">
  <img class="avatar" src={avatar} alt={`Portrait of ${profile.name}`} />
  <h1 class="name">
    {profile.name}
    <span class="name-zh">({profile.nameZh})</span>
  </h1>
  <p class="title">{profile.title}</p>

  <ul class="meta">
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span>{profile.location}</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
      <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 10L12 5 2 10l10 5 10-5z"></path>
        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
      </svg>
      <a href={profile.scholar} target="_blank" rel="noopener">Google Scholar</a>
    </li>
  </ul>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 56px;
  }

  .avatar {
    width: 148px;
    height: 148px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
  }

  .name {
    margin-top: 24px;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .name-zh {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 2px;
  }

  .title {
    margin-top: 6px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .meta {
    list-style: none;
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .meta li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .meta svg {
    width: 16px;
    height: 16px;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .meta a {
    color: var(--text-secondary);
    text-decoration-color: var(--line-strong);
    word-break: break-all;
  }

  .meta a:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }

  /* 窄屏:侧栏变为顶部区块,内容居中 */
  @media (max-width: 860px) {
    .sidebar {
      position: static;
      text-align: center;
    }

    .avatar {
      margin: 0 auto;
    }

    .meta {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 26px;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
