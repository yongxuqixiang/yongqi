---
import { profile } from '../data/profile';
---

<section id="about" class="section">
  <h2 class="section-title reveal">📖 About Me</h2>
  <div class="reveal">
    {profile.bio.map((p) => <p class="bio-p">{p}</p>)}
  </div>
</section>

<style>
  .bio-p {
    font-size: 16px;
    line-height: 1.9;
  }

  .bio-p + .bio-p {
    margin-top: 18px;
  }
</style>
